<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos 음성 합성 서비스 접근 권한 (공식 문서: TextToSpeech > declaring-permissions) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 차량 신호 읽기 권한: Vehicle SDK 2.3.2의 @RequiresPermission 표기 기준, 쓰는 API에 필요한 것만 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- 브레이크, 기어 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- 방향지시등 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- 와이퍼 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />    <!-- 시트 열선, 안전벨트 체결 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />    <!-- 도어 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />   <!-- 안전벨트 경고 -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StoryDrive">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
